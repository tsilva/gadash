{
  "name": "gadash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "next build",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "audit": "pnpm audit --audit-level low",
    "dev:app": "node scripts/dev-server.mjs next dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py"
  },
  "dependencies": {
    "@sentry/nextjs": "10.69.0",
    "@vercel/analytics": "1.6.1",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
